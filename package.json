{
  "name": "jiumao-warehouse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-locale-html.mjs",
    "build:goose": "vite build --config vite.goose.config.ts",
    "generate:locale-html": "node scripts/generate-locale-html.mjs",
    "preview": "vite preview",
    "test:lang-switch": "playwright test e2e/lang-switch.spec.ts",
    "postinstall": "mkdir -p public/ffmpeg && cp node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.js node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.wasm public/ffmpeg/",
    "test:arena-rules": "node --experimental-strip-types tests/arena/rules.check.ts && node --experimental-strip-types tests/arena/boards.check.ts && node --experimental-strip-types --test tests/arena/rules.qa.ts",
    "test:arena-audio": "node --experimental-strip-types tests/arena/audio-destroy.check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "heic2any": "^0.0.4",
    "icodec": "^0.6.0",
    "iwork-preview": "^1.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "snappyjs": "^0.7.0",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0",
    "zustand": "^5.0.14"
  }
}
