# Copy to /etc/maotaiworks/daily.env and chmod 600.
# Placeholder values only. Do not commit the real file.

# Deployed site root. The job writes only inside ai-daily/, ai-skills/, and arena-data/.
DIST_DIR=/var/www/maotaiworks/dist

# Log file directory. The process also writes to stderr (journald when run from systemd).
LOG_DIR=/var/log/maotaiworks

# OpenAI-compatible chat API. Swap the provider by changing these three lines.
# DeepSeek (default):
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=gpt-4o-mini
# Gemini (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=replace-me
# LLM_MODEL=gemini-2.0-flash

# Optional. Unauthenticated GitHub search is enough for one daily run.
# GITHUB_TOKEN=replace-me
