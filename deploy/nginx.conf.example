# 九猫库 · maotaiworks.com
# 用法：复制到 /etc/nginx/sites-available/maotaiworks.com 并软链到 sites-enabled
# 将 root 改成你服务器上 dist 目录的实际路径
#
# SEO i18n：公开页使用 /{locale}/… 路径前缀；/ 与无前缀应用路径 301 → /zh-cn/…

server {
    listen 80;
    listen [::]:80;
    server_name maotaiworks.com www.maotaiworks.com;
    return 301 https://maotaiworks.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.maotaiworks.com;
    # ssl_certificate     /etc/letsencrypt/live/maotaiworks.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/maotaiworks.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    return 301 https://maotaiworks.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name maotaiworks.com;

    # ssl_certificate     /etc/letsencrypt/live/maotaiworks.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/maotaiworks.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;

    root /var/www/maotaiworks/dist;
    index index.html;

    # pdf.js worker (ESM)
    location = /pdf.worker.min.mjs {
        default_type application/javascript;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /downloads/ {
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /ffmpeg/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # 后台不加语言前缀
    location /admin/ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri $uri/ /admin/index.html;
    }

    # APIs
    location /api/store/ {
        proxy_pass http://127.0.0.1:3192/api/store/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/switch/ {
        proxy_pass http://127.0.0.1:3193/api/switch/;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/visit {
        proxy_pass http://127.0.0.1:3190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/event {
        proxy_pass http://127.0.0.1:3190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/note {
        proxy_pass http://127.0.0.1:3190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/ {
        proxy_pass http://127.0.0.1:3190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ebook-convert {
        client_max_body_size 42m;
        proxy_pass http://127.0.0.1:3191;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/account/ {
        proxy_pass http://127.0.0.1:3194/api/account/;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AI 日报数据：每天替换 /ai-daily/latest.json（另存 YYYY-MM-DD.json）即可更新首页两个模块和 /ai/，不缓存
    location ^~ /ai-daily/ {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri =404;
    }

    # AI 最新 Skill 数据：每天替换 /ai-skills/latest.json（另存 YYYY-MM-DD.json）即可更新首页模块和 /ai/，不缓存
    location ^~ /ai-skills/ {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri =404;
    }

    # AI 竞技场数据：每天替换 /arena-data/latest.json（另存 YYYY-MM-DD.json），不缓存
    location ^~ /arena-data/ {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri =404;
    }

    location = /robots.txt {
        try_files $uri =404;
    }

    location = /sitemap.xml {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # 根路径 → 默认语言
    location = / {
        return 301 /zh-cn/;
    }

    # 旧无前缀应用 URL → /zh-cn/…
    location ~ ^/(moyee|ebook|image|store|switch|legal|markdown|platform-crop|video-mute|scratch|tank|ai|arena)(/.*)?$ {
        return 301 /zh-cn$request_uri;
    }

    # 语言前缀：优先预生成 HTML 壳，否则回落到无前缀应用入口
    # /en 与 /en/
    location ~ ^/(zh-cn|zh-tw|en|ja|ko|fr|de|es|hi|th|ru|pt)/?$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files /$1/index.html /index.html;
    }

    # /en/image/… → dist/en/image/index.html → dist/image/index.html
    # /zh-cn/ai/ → dist/zh-cn/ai/index.html（AI 日报页）
    location ~ ^/(zh-cn|zh-tw|en|ja|ko|fr|de|es|hi|th|ru|pt)/(moyee|ebook|image|store|switch|legal|markdown|platform-crop|video-mute|scratch|tank|ai|arena)(/.*)?$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files /$1/$2$3 /$1/$2/index.html /$2$3 /$2/index.html =404;
    }

    location ~* \.html$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
